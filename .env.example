# Application environment.
ENVIRONMENT=development

# Language model provider and model used by the application.
LLM_PROVIDER=fake
LLM_MODEL=fake-model

# Language model API key. Leave blank for the fake provider or local development.
LLM_API_KEY=

# Optional GitHub token for authenticated API requests.
# Leave blank when GitHub authentication is not required.
# Never commit a real token or any other secret to version control.
GITHUB_TOKEN=

# GitHub API base URL.
GITHUB_API_BASE_URL=https://api.github.com

# Database connection URL for local development.
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Production example. Replace placeholders with deployment-specific values.
# Never commit production credentials to version control.
# ENVIRONMENT=production
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
