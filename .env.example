# =============================================================================
# DevPilot AI - environment variables
#
# Copy this file to `.env` for local development and fill only the values your
# environment needs. Never commit a real `.env`, token, API key or connection
# string with credentials. `.env.example` contains placeholders only.
# =============================================================================

# Application environment: development | production.
ENVIRONMENT=development

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL).
# SQLAlchemy parameters are always redacted before reaching any handler; do not
# enable SQLAlchemy ``echo`` to inspect user code.
LOG_LEVEL=INFO

# Database URL.
# Local SQLite (async driver):
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Production/Neon (commented). ``sslmode`` is translated to asyncpg's ``ssl``.
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<database>?sslmode=require

# Language model provider used by the correction flow.
# ``fake`` is deterministic and answers 503 unless CORRECTION_FAKE_PROVIDER_ENABLED=true.
LLM_PROVIDER=fake
LLM_MODEL=fake-model
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# GitHub repository loading.
# GITHUB_TOKEN is optional (private repositories and higher rate limits).
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_MAX_FILES=1000
GITHUB_MAX_FILE_BYTES=1000000
GITHUB_MAX_TOTAL_BYTES=5000000
# Tree paths collected as repository context; larger trees are truncated and
# reported as tree_complete=false (unknown, never "missing").
GITHUB_MAX_TREE_PATHS=5000
# Maximum size of the root apps.json metadata file read for Protheus repos.
GITHUB_APPS_JSON_MAX_BYTES=65536
# Global time budget (seconds) for one POST /repositories/load.
GITHUB_LOAD_TOTAL_SECONDS=60

# Maximum accepted source code size, in bytes, for POST /analyses.
MAX_SOURCE_CODE_BYTES=1000000
# Cap of deterministic relation-graph edges per analysis.
RELATIONS_MAX_EDGES=5000

# CORS: comma-separated *exact* origins (scheme + host + port), never ``*``.
# Leave blank to disable cross-origin access (same-origin only).
# Local Angular dev server:
# FRONTEND_ORIGINS=http://localhost:4200
# Published GitHub Pages frontend (use the exact origin, no path):
# FRONTEND_ORIGINS=https://<user>.github.io
# Multiple origins are comma-separated. Only the deployment owner controls
# this list; credentials are intentionally not allowed cross-origin.
FRONTEND_ORIGINS=

# In-memory rate limiting for expensive public endpoints
# (POST /analyses and POST /repositories/load), per client IP.
# The default is generous for local development; public deployments should
# lower RATE_LIMIT_REQUESTS (for example to 10). 0 disables throttling.
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
# Trust X-Forwarded-For only behind a known reverse proxy (Render/Cloudflare).
# Leave false when clients can reach the app directly; the header is forgeable.
TRUST_PROXY_HEADERS=false

# AI correction (POST /corrections). The returned code is never executed.
CORRECTION_MAX_SOURCE_BYTES=200000
CORRECTION_MAX_CORRECTED_BYTES=1000000
CORRECTION_MAX_EXPLANATION_BYTES=20000
CORRECTION_RATE_LIMIT_REQUESTS=20
CORRECTION_RATE_LIMIT_WINDOW_SECONDS=60
# Explicit opt-in required to expose the correction endpoint with LLM_PROVIDER=fake.
CORRECTION_FAKE_PROVIDER_ENABLED=false

# ADVPL validation stays heuristic unless an official toolchain is configured.
# Nothing in this repository runs a build.
ADVPL_OFFICIAL_VALIDATION_ENABLED=false

# Firebase Authentication (optional). Without these values the API still starts
# and public endpoints keep working; authenticated endpoints answer 401.
# FIREBASE_PROJECT_ID is not a secret (the frontend uses the same project id).
FIREBASE_PROJECT_ID=
# Service account JSON (single line) used by the Admin SDK to verify ID tokens.
# THIS IS A SECRET: keep it only in the deployment environment, never in the
# repository, and never in a log or a screenshot.
FIREBASE_SERVICE_ACCOUNT_JSON=
