# Optional GitHub token for authenticated API requests.
# Leave this as a placeholder or blank if authentication is not needed.
# Never commit a real GitHub token or any other secret to version control.
GITHUB_TOKEN=your_github_token_here

# GitHub API base URL.
GITHUB_API_URL=https://api.github.com

# Database connection URL for local development.
# SQLite requires no external database or credentials.
DATABASE_URL=sqlite:///./devpilot.db

# PostgreSQL example for production. Replace every placeholder with your
# deployment-specific value, and never commit production credentials.
# DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database>
