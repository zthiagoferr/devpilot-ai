# Application environment.
ENVIRONMENT=development

# Language model provider and model used by the application.
LLM_PROVIDER=fake
LLM_MODEL=fake-model

# Language model API key. Leave blank for the fake provider or local development.
LLM_API_KEY=

# Optional GitHub token for authenticated API requests.
# Leave blank when GitHub authentication is not required.
# Never commit a real token or any other secret to version control.
GITHUB_TOKEN=

# GitHub API base URL.
GITHUB_API_BASE_URL=https://api.github.com

# Database connection URL for local development.
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Logging level for the application (DEBUG, INFO, WARNING, ERROR, CRITICAL).
LOG_LEVEL=INFO

# Comma-separated allowlist of frontend origins permitted for CORS requests.
# Leave blank to disable cross-origin access (same-origin only).
FRONTEND_ORIGINS=

# Firebase Authentication (optional). Without these values the API still starts
# and the public endpoints keep working; authenticated endpoints answer 401.
# FIREBASE_PROJECT_ID is not a secret (the frontend uses the same project id).
FIREBASE_PROJECT_ID=

# Service account JSON (single line) used by the Admin SDK to verify ID tokens.
# THIS IS A SECRET: keep it only in the deployment environment, never in the
# repository, and never in a log or a screenshot.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Timeout in seconds for language model requests.
LLM_TIMEOUT_SECONDS=30

# Maximum accepted source code size, in bytes.
MAX_SOURCE_CODE_BYTES=1000000

# GitHub repository traversal limits.
GITHUB_MAX_FILES=1000
GITHUB_MAX_FILE_BYTES=1000000
GITHUB_MAX_TOTAL_BYTES=5000000

# Total time budget, in seconds, for a single repository load request.
# Shared by every file download and enforced on top of the per-request timeout.
GITHUB_LOAD_TOTAL_SECONDS=60

# In-memory rate limiting for the expensive public endpoints
# (POST /analyses and POST /repositories/load), per client IP.
# The default is generous so local development is not throttled; public
# deployments should lower RATE_LIMIT_REQUESTS (for example to 10).
# A value of 0 disables throttling.
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Trust X-Forwarded-For for identifying the client. Enable ONLY when the app
# runs behind a known reverse proxy (for example the Render/Cloudflare edge);
# leave false when clients can reach the app directly, since the header can be
# forged and would let a caller evade the rate limit.
TRUST_PROXY_HEADERS=false

# Production example. Replace placeholders with deployment-specific values.
# Never commit production credentials to version control.
# ENVIRONMENT=production
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
